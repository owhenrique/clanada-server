DATABASE_URL=postgresql://clanada:clanada@localhost:5432/clanada?schema=public
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Rate limit por IP e por rota (janela em ms)
THROTTLE_TTL_MS=60000
THROTTLE_GLOBAL_LIMIT=120
THROTTLE_CREATE_LIMIT=10
THROTTLE_LOOKUP_MISS_LIMIT=10

# Proxies reversos na frente da API (0 em dev; 1 atrás do Caddy)
TRUST_PROXY_HOPS=0
