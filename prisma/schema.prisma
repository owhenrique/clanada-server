datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

enum MatchStatus {
  DRAFT
  ACTIVE
  ENDED
}

model Match {
  id             String       @id @default(uuid()) @db.Uuid
  code           String       @unique
  status         MatchStatus
  version        Int
  snapshot       Json
  timerStartedAt DateTime?
  timerElapsedMs Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  events         MatchEvent[]
}

model MatchEvent {
  id        BigInt    @id @default(autoincrement())
  matchId   String    @db.Uuid
  match     Match     @relation(fields: [matchId], references: [id])
  seq       Int
  type      String
  payload   Json
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([matchId, seq])
  @@index([matchId, seq])
}
